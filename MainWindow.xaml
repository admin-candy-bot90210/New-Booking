<Window x:Class="DJBookingSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Booking System" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Logout" Click="Logout_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_My Settings" Click="MySettings_Click"/>
                <MenuItem Header="_Stay On Top" x:Name="StayOnTopMenuItem" IsCheckable="True" Checked="StayOnTop_Checked" Unchecked="StayOnTop_Unchecked"/>
            </MenuItem>
            <MenuItem Header="_Communication">
                <MenuItem Header="_Chat" Click="Chat_Click"/>
            </MenuItem>
            <MenuItem Header="_Radio">
                <MenuItem Header="_Radio Player" Click="RadioPlayer_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help Guide" Click="HelpGuide_Click"/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Header -->
        <Border Grid.Row="1" Background="#2C3E50" Padding="15">
            <StackPanel>
                <TextBlock Text="DJ Booking Management System"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock x:Name="ConnectionStatus"
                          Text="Not Connected to Firebase"
                          FontSize="12"
                          Foreground="#ECF0F1"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" Margin="10">
            <!-- Bookings List Tab -->
            <TabItem x:Name="DJBookingsTab" Header="DJ Bookings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Filter by Venue:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="VenueFilterComboBox"
                                 Width="200"
                                 SelectionChanged="VenueFilter_Changed"/>
                        <Button Content="Refresh"
                               Click="RefreshBookings_Click"
                               Margin="20,0,0,0"
                               Padding="15,5"/>
                    </StackPanel>

                    <!-- Bookings DataGrid -->
                    <DataGrid x:Name="BookingsDataGrid"
                             Grid.Row="1"
                             Margin="10"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             SelectionMode="Single"
                             IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DJ Name" Binding="{Binding DJName}" Width="200"/>
                            <DataGridTextColumn x:Name="StreamingLinkColumn" Header="Streaming Link" Binding="{Binding StreamingLink}" Width="300"/>
                            <DataGridTextColumn Header="Venue" Binding="{Binding Venue}" Width="200"/>
                            <DataGridTextColumn Header="Booking Date" Binding="{Binding BookingDate, StringFormat=\{0:MM/dd/yyyy HH:mm\}}" Width="150"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=\{0:MM/dd/yyyy\}}" Width="120"/>
                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="📋 Copy Link"
                                                   Click="CopyStreamingLink_Click"
                                                   Tag="{Binding ActualStreamingLink}"
                                                   Padding="8,4"
                                                   Margin="2"
                                                   Background="#27AE60"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Cursor="Hand"
                                                   FontSize="11"
                                                   Visibility="{Binding CanCopyStreamingLink, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Content="View Details"
                               Click="ViewDetails_Click"
                               Padding="15,5"
                               Margin="5"/>
                        <Button x:Name="EditBookingButton"
                               Content="Edit"
                               Click="EditBooking_Click"
                               Padding="15,5"
                               Margin="5"/>
                        <Button x:Name="DeleteBookingButton"
                               Content="Delete"
                               Click="DeleteBooking_Click"
                               Padding="15,5"
                               Margin="5"
                               Background="#E74C3C"
                               Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Add New Booking Tab -->
            <TabItem x:Name="NewDJBookingTab" Header="New DJ Booking">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="600">
                        <TextBlock Text="Add New DJ Booking" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="DJ Name:*" Margin="0,5,0,2"/>
                        <TextBox x:Name="DJNameTextBox" Padding="5"/>

                        <TextBlock Text="Streaming Link:*" Margin="0,10,0,2"/>
                        <TextBox x:Name="StreamingLinkTextBox" Padding="5"/>

                        <TextBlock Text="Venue:*" Margin="0,10,0,2"/>
                        <ComboBox x:Name="VenueComboBox" Padding="5"/>

                        <TextBlock Text="Booking Date &amp; Time:*" Margin="0,10,0,2"/>
                        <DatePicker x:Name="BookingDatePicker" Padding="5" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Time:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="HourComboBox" Width="60" SelectedIndex="18"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0"/>
                            <ComboBox x:Name="MinuteComboBox" Width="60" SelectedIndex="0"/>
                        </StackPanel>

                        <Button Content="Add DJ Booking"
                               Click="AddBooking_Click"
                               Padding="15,10"
                               Margin="0,20,0,0"
                               Background="#27AE60"
                               Foreground="White"
                               FontSize="16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Venue Management Tab -->
            <TabItem x:Name="ManageVenuesTab" Header="Manage Venues">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Venue Registration Button -->
                    <Border Grid.Row="0" Background="#3498DB" Padding="15" Margin="10,10,10,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Venue Owner?"
                                      VerticalAlignment="Center"
                                      Foreground="White"
                                      FontSize="14"
                                      Margin="0,0,10,0"/>
                            <Button x:Name="RegisterVenueButton"
                                   Content="Register Your Venue (Free!)"
                                   Click="RegisterVenue_Click"
                                   Padding="20,8"
                                   Background="#27AE60"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="VenuesDataGrid"
                             Grid.Row="1"
                             Margin="10"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             SelectionMode="Single"
                             IsReadOnly="True"
                             MouseDoubleClick="VenueDetails_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Room Name" Binding="{Binding RoomName}" Width="200"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding RoomDescription}" Width="350"/>
                            <DataGridTextColumn Header="Opening Hours" Binding="{Binding OpeningHours}" Width="200"/>
                            <DataGridCheckBoxColumn Header="Open" Binding="{Binding IsOpen}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="View Details"
                                   Click="ViewVenueDetails_Click"
                                   Padding="15,5"
                                   Margin="5"/>
                            <Button Content="Daily Schedule"
                                   Click="ViewDailySchedule_Click"
                                   Padding="15,5"
                                   Margin="5"
                                   Background="#9B59B6"
                                   Foreground="White"/>
                            <Button x:Name="ToggleVenueButton"
                                   Content="Toggle Open/Closed"
                                   Click="ToggleVenue_Click"
                                   Padding="15,5"
                                   Margin="5"/>
                            <Button x:Name="DeleteVenueButton"
                                   Content="Delete Venue"
                                   Click="DeleteVenue_Click"
                                   Padding="15,5"
                                   Margin="5"
                                   Background="#E74C3C"
                                   Foreground="White"/>
                            <Button Content="Refresh Venues"
                                   Click="RefreshVenues_Click"
                                   Padding="15,5"
                                   Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Admin Panel Tab -->
            <TabItem x:Name="AdminTab" Header="Admin Panel" Visibility="Collapsed">
                <Grid Margin="20">
                    <StackPanel MaxWidth="600">
                        <TextBlock Text="SysAdmin Panel"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Margin="0,0,0,20"/>

                        <Button Content="Manage Users"
                               Click="ManageUsers_Click"
                               Padding="15,10"
                               Margin="0,5"
                               HorizontalAlignment="Left"
                               Width="250"
                               Background="#3498DB"
                               Foreground="White"/>

                        <Button Content="Customize App (Coming Soon)"
                               Click="CustomizeApp_Click"
                               Padding="15,10"
                               Margin="0,5"
                               HorizontalAlignment="Left"
                               Width="250"
                               Background="#9B59B6"
                               Foreground="White"/>

                        <TextBlock x:Name="RadioBossSectionHeader"
                                  Text="RadioBOSS Cloud Control"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Margin="0,30,0,10"/>

                        <Button x:Name="RadioBossControlButton"
                               Content="RadioBOSS API Control Panel"
                               Click="OpenRadioBossControl_Click"
                               Padding="15,10"
                               Margin="0,5"
                               HorizontalAlignment="Left"
                               Width="250"
                               Background="#E67E22"
                               Foreground="White"/>

                        <Button x:Name="RadioBossWebButton"
                               Content="RadioBOSS Web Interface"
                               Click="OpenRadioBossWeb_Click"
                               Padding="15,10"
                               Margin="0,5"
                               HorizontalAlignment="Left"
                               Width="250"
                               Background="#1ABC9C"
                               Foreground="White"/>

                        <TextBlock Text="Current User Information"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Margin="0,30,0,10"/>

                        <TextBlock x:Name="CurrentUserInfoTextBlock"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,20"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
