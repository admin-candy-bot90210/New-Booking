<Window x:Class="DJBookingSystem.RadioBossBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RadioBOSS Cloud Control" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RadioBOSS Cloud Control Panel"
                          FontSize="18"
                          FontWeight="Bold"
                          Foreground="White"
                          VerticalAlignment="Center"/>
                <Button x:Name="RefreshButton"
                       Content="Refresh"
                       Click="Refresh_Click"
                       Margin="20,0,0,0"
                       Padding="10,5"
                       Background="#3498DB"
                       Foreground="White"
                       BorderThickness="0"/>
                <Button x:Name="HomeButton"
                       Content="Home"
                       Click="Home_Click"
                       Margin="10,0,0,0"
                       Padding="10,5"
                       Background="#27AE60"
                       Foreground="White"
                       BorderThickness="0"/>
                <TextBlock x:Name="StatusTextBlock"
                          Text="Loading..."
                          Margin="20,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- WebView2 Browser -->
        <wv2:WebView2 x:Name="RadioBossWebView"
                      Grid.Row="1"
                      Source="https://c40.radioboss.fm/#main"/>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#34495E" Padding="10">
            <TextBlock Text="Auto-logged in as: Remote | Full RadioBOSS Cloud functionality available"
                      Foreground="White"
                      HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
