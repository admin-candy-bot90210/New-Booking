<Window x:Class="DJBookingSystem.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DJBookingSystem.Converters"
        Title="DJ Booking System - Chat" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#ECF0F1"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:UserRoleToColorConverter x:Key="RoleToColorConverter"/>
        <converters:UserRoleToBadgeColorConverter x:Key="RoleToBadgeColorConverter"/>
        <converters:UserRoleToLabelConverter x:Key="RoleToLabelConverter"/>
        <converters:UserRoleToIconConverter x:Key="RoleToIconConverter"/>

        <!-- Channel Button Style -->
        <Style x:Key="ChannelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                               Padding="{TemplateBinding Padding}"
                               CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#34495E"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Channels -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="CHANNELS"
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="White"
                          Margin="0,0,0,15"/>

                <!-- World Channel -->
                <Button x:Name="WorldChannelButton"
                       Click="WorldChannel_Click"
                       Style="{StaticResource ChannelButtonStyle}"
                       Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌍" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="World" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- To Admin Channel -->
                <Button x:Name="ToAdminChannelButton"
                       Click="ToAdminChannel_Click"
                       Style="{StaticResource ChannelButtonStyle}"
                       Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🆘" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="To Admin" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- Admin Only Channel -->
                <Button x:Name="AdminOnlyChannelButton"
                       Click="AdminOnlyChannel_Click"
                       Style="{StaticResource ChannelButtonStyle}"
                       Margin="0,0,0,5"
                       Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Admin Only" FontSize="13" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Separator Background="#34495E" Margin="0,10"/>

                <TextBlock Text="DIRECT MESSAGES"
                          FontSize="12"
                          FontWeight="Bold"
                          Foreground="White"
                          Margin="0,10,0,10"/>

                <Button Content="+ Start Private Chat"
                       Click="StartPrivateChat_Click"
                       Background="#3498DB"
                       Foreground="White"
                       Padding="8,5"
                       Margin="0,0,0,10"
                       Cursor="Hand"
                       FontSize="11"
                       BorderThickness="0"/>

                <!-- Private Conversations List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <ItemsControl x:Name="PrivateConversationsListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="PrivateConversation_Click"
                                       Tag="{Binding Username}"
                                       Style="{StaticResource ChannelButtonStyle}"
                                       Margin="0,0,0,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Username}" FontSize="11" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Center Panel: Chat Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#34495E" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="HeaderTextBlock"
                                  Text="🌍 World Chat"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock x:Name="SubHeaderTextBlock"
                                  Text="Public chat - visible to all users"
                                  FontSize="11"
                                  Foreground="#ECF0F1"
                                  Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="🔄 Refresh"
                               Click="Refresh_Click"
                               Padding="10,5"
                               Margin="5,0"
                               Background="#3498DB"
                               Foreground="White"
                               BorderThickness="0"
                               Cursor="Hand"/>
                        <Button Content="⚙️ Settings"
                               Click="ChatSettings_Click"
                               Padding="10,5"
                               Margin="5,0"
                               Background="#9B59B6"
                               Foreground="White"
                               BorderThickness="0"
                               Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Messages -->
            <Border Grid.Row="1" Background="White" Margin="0" Padding="10">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChatMessagesControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Padding="12" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F8F9FA"/>
                                            <Setter Property="BorderBrush" Value="#DEE2E6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                                    <Setter Property="Background" Value="#FFE6E6"/>
                                                    <Setter Property="BorderBrush" Value="#E74C3C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Sender Info with Role Icon -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <!-- Role Icon -->
                                            <TextBlock FontSize="16" Margin="0,0,8,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource RoleToIconConverter}">
                                                        <Binding Path="SenderRole"/>
                                                        <Binding Path="SenderIsDJ"/>
                                                        <Binding Path="SenderIsVenueOwner"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>

                                            <!-- Username with Role Color (Rainbow for SysAdmin, others solid) -->
                                            <TextBlock Text="{Binding SenderUsername}"
                                                      FontWeight="Bold"
                                                      FontSize="13">
                                                <TextBlock.Foreground>
                                                    <MultiBinding Converter="{StaticResource RoleToColorConverter}">
                                                        <Binding Path="SenderRole"/>
                                                        <Binding Path="SenderIsDJ"/>
                                                        <Binding Path="SenderIsVenueOwner"/>
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>

                                            <!-- Role Badge -->
                                            <Border Padding="6,2" Margin="8,0,0,0" CornerRadius="3">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource RoleToBadgeColorConverter}">
                                                        <Binding Path="SenderRole"/>
                                                        <Binding Path="SenderIsDJ"/>
                                                        <Binding Path="SenderIsVenueOwner"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Foreground="White"
                                                          FontSize="10"
                                                          FontWeight="Bold">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource RoleToLabelConverter}">
                                                            <Binding Path="SenderRole"/>
                                                            <Binding Path="SenderIsDJ"/>
                                                            <Binding Path="SenderIsVenueOwner"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>

                                        <!-- Message Text -->
                                        <TextBlock Grid.Row="1"
                                                  Text="{Binding Message}"
                                                  TextWrapping="Wrap"
                                                  Margin="24,8,0,0"
                                                  FontSize="13"
                                                  Foreground="#2C3E50"/>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Row="2"
                                                  Text="{Binding Timestamp, StringFormat='HH:mm:ss - dd/MM/yyyy'}"
                                                  FontSize="10"
                                                  Foreground="#7F8C8D"
                                                  Margin="24,6,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Statistics Panel (SysAdmin Only) -->
            <Border Grid.Row="2" x:Name="StatsPanel" Background="#3498DB" Padding="10" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="TotalMessagesText"
                              Text="Total: 0"
                              Foreground="White"
                              FontWeight="Bold"
                              Margin="15,0"/>
                    <TextBlock x:Name="ErrorCountText"
                              Text="Errors: 0"
                              Foreground="#FFE6E6"
                              FontWeight="Bold"
                              Margin="15,0"/>
                    <TextBlock x:Name="OnlineUsersText"
                              Text="Online: 0"
                              Foreground="White"
                              FontWeight="Bold"
                              Margin="15,0"/>
                </StackPanel>
            </Border>

            <!-- Message Input -->
            <Border Grid.Row="3" Background="#F8F9FA" Padding="15" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MessageTextBox"
                            Grid.Column="0"
                            Padding="12"
                            FontSize="13"
                            VerticalContentAlignment="Center"
                            KeyDown="MessageTextBox_KeyDown"
                            MaxLength="1000"
                            TextWrapping="Wrap"
                            AcceptsReturn="False"
                            Height="40"/>

                    <Button Grid.Column="1"
                           Content="📤 Send"
                           Click="Send_Click"
                           Padding="20,10"
                           Margin="10,0,0,0"
                           FontSize="14"
                           FontWeight="Bold"
                           Background="#27AE60"
                           Foreground="White"
                           BorderThickness="0"
                           Cursor="Hand"
                           Height="40"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Panel: User List & Actions -->
        <Border Grid.Column="2" Background="#ECF0F1" Padding="10">
            <StackPanel>
                <TextBlock Text="ONLINE USERS"
                          FontSize="12"
                          FontWeight="Bold"
                          Foreground="#2C3E50"
                          Margin="0,0,0,10"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                    <ItemsControl x:Name="OnlineUsersListBox">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                       Padding="8"
                                       Margin="0,0,0,5"
                                       CornerRadius="5"
                                       BorderBrush="#BDC3C7"
                                       BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- User Info -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#27AE60" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Username}"
                                                      FontWeight="Bold"
                                                      FontSize="11"
                                                      Foreground="#2C3E50"/>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,5,0,0">
                                            <Button Content="💬"
                                                   ToolTip="Send Private Message"
                                                   Click="SendPrivateMessage_Click"
                                                   Tag="{Binding Username}"
                                                   Padding="4,2"
                                                   Margin="0,0,3,0"
                                                   FontSize="12"
                                                   Background="#3498DB"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Cursor="Hand"/>
                                            <Button Content="🔇"
                                                   ToolTip="Mute User"
                                                   Click="MuteUser_Click"
                                                   Tag="{Binding Username}"
                                                   Padding="4,2"
                                                   Margin="0,0,3,0"
                                                   FontSize="12"
                                                   Background="#F39C12"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Cursor="Hand"/>
                                            <Button Content="🚫"
                                                   ToolTip="Block User"
                                                   Click="BlockUser_Click"
                                                   Tag="{Binding Username}"
                                                   Padding="4,2"
                                                   Margin="0,0,3,0"
                                                   FontSize="12"
                                                   Background="#E74C3C"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Cursor="Hand"/>
                                            <Button Content="⚠️"
                                                   ToolTip="Report User"
                                                   Click="ReportUser_Click"
                                                   Tag="{Binding Username}"
                                                   Padding="4,2"
                                                   FontSize="12"
                                                   Background="#E67E22"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Separator Margin="0,15"/>

                <TextBlock Text="BLOCKED USERS"
                          FontSize="12"
                          FontWeight="Bold"
                          Foreground="#2C3E50"
                          Margin="0,10,0,10"/>

                <Button Content="Manage Blocked Users"
                       Click="ManageBlockedUsers_Click"
                       Background="#E74C3C"
                       Foreground="White"
                       Padding="8,5"
                       BorderThickness="0"
                       Cursor="Hand"
                       FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
