<Window x:Class="DJBookingSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Booking System - Login" Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#ECF0F1"
        Opacity="0">
    <Window.Resources>
        <!-- Fade-in animation -->
        <Storyboard x:Key="FadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                           From="0.0" To="1.0" Duration="0:0:0.8"/>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="DJ Booking System"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Please login to continue"
                          FontSize="12"
                          Foreground="#ECF0F1"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <Border Grid.Row="1" Padding="40" Background="White" Margin="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Username" FontSize="14" Margin="0,0,0,5"/>
                <TextBox x:Name="UsernameTextBox"
                        Padding="10"
                        FontSize="14"
                        Margin="0,0,0,20"/>

                <TextBlock Text="Password" FontSize="14" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox"
                            Padding="10"
                            FontSize="14"
                            Margin="0,0,0,10"/>

                <CheckBox x:Name="RememberMeCheckBox"
                         Content="Remember Me"
                         Margin="0,10,0,0"/>

                <TextBlock x:Name="ErrorMessageTextBlock"
                          Text=""
                          Foreground="#E74C3C"
                          FontSize="12"
                          Margin="0,10,0,10"
                          TextWrapping="Wrap"
                          Visibility="Collapsed"/>

                <Button Content="Login"
                       Click="Login_Click"
                       Padding="15"
                       FontSize="16"
                       FontWeight="Bold"
                       Background="#3498DB"
                       Foreground="White"
                       Margin="0,10,0,0"
                       Cursor="Hand"/>

                <Button Content="Register New Account"
                       Click="Register_Click"
                       Padding="12"
                       FontSize="14"
                       Background="#27AE60"
                       Foreground="White"
                       Margin="0,10,0,0"
                       Cursor="Hand"/>

                <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" HorizontalAlignment="Center">
                    <Run Text="Default SysAdmin:"/>
                    <LineBreak/>
                    <Run Text="Username: " FontWeight="Bold"/>
                    <Run Text="admin"/>
                    <LineBreak/>
                    <Run Text="Password: " FontWeight="Bold"/>
                    <Run Text="admin123"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
