<Window x:Class="DJBookingSystem.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DJ Booking System - Chat" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#ECF0F1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="HeaderTextBlock"
                              Text="Chat - All Users"
                              FontSize="18"
                              FontWeight="Bold"
                              Foreground="White"/>
                    <TextBlock x:Name="SubHeaderTextBlock"
                              Text="Communicate with other users"
                              FontSize="11"
                              Foreground="#ECF0F1"
                              Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Show Errors Only"
                           x:Name="FilterErrorsButton"
                           Click="FilterErrors_Click"
                           Padding="10,5"
                           Margin="5,0"
                           Background="#E74C3C"
                           Foreground="White"
                           Cursor="Hand"/>
                    <Button Content="Refresh"
                           Click="Refresh_Click"
                           Padding="10,5"
                           Margin="5,0"
                           Background="#3498DB"
                           Foreground="White"
                           Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat Messages -->
        <Border Grid.Row="1" Background="White" Margin="10" Padding="10">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChatMessagesControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Padding="10" CornerRadius="5" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECF0F1"/>
                                        <Setter Property="BorderBrush" Value="#BDC3C7"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsErrorMessage}" Value="True">
                                                <Setter Property="Background" Value="#FFE6E6"/>
                                                <Setter Property="BorderBrush" Value="#E74C3C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SenderUsername}"
                                                  FontWeight="Bold"
                                                  Foreground="#2C3E50"/>
                                        <TextBlock Text=" [" Foreground="#7F8C8D" Margin="3,0,0,0"/>
                                        <TextBlock Text="{Binding SenderRole}"
                                                  Foreground="#3498DB"
                                                  FontStyle="Italic"/>
                                        <TextBlock Text="]" Foreground="#7F8C8D"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                              Text="{Binding Message}"
                                              TextWrapping="Wrap"
                                              Margin="0,5,0,0"
                                              Foreground="#2C3E50"/>

                                    <TextBlock Grid.Row="2"
                                              Text="{Binding Timestamp, StringFormat='HH:mm:ss - dd/MM/yyyy'}"
                                              FontSize="10"
                                              Foreground="#7F8C8D"
                                              Margin="0,5,0,0"
                                              HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Statistics Panel (SysAdmin Only) -->
        <Border Grid.Row="2" x:Name="StatsPanel" Background="#3498DB" Padding="10" Margin="10,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TotalMessagesText"
                          Text="Total Messages: 0"
                          Foreground="White"
                          FontWeight="Bold"
                          Margin="10,0"/>
                <TextBlock x:Name="ErrorCountText"
                          Text="Errors: 0"
                          Foreground="#FFE6E6"
                          FontWeight="Bold"
                          Margin="10,0"/>
                <TextBlock x:Name="TodayMessagesText"
                          Text="Today: 0"
                          Foreground="White"
                          FontWeight="Bold"
                          Margin="10,0"/>
            </StackPanel>
        </Border>

        <!-- Message Input -->
        <Border Grid.Row="3" Background="White" Padding="10" BorderBrush="#BDC3C7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                        Grid.Column="0"
                        Padding="10"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        KeyDown="MessageTextBox_KeyDown"
                        MaxLength="500"/>

                <Button Grid.Column="1"
                       Content="Send"
                       Click="Send_Click"
                       Padding="30,10"
                       Margin="10,0,0,0"
                       FontSize="14"
                       Background="#27AE60"
                       Foreground="White"
                       Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
