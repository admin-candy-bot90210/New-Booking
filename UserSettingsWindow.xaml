<Window x:Class="DJBookingSystem.UserSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Settings" Height="600" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20" Margin="-20,-20,-20,20">
            <StackPanel>
                <TextBlock Text="My Settings"
                          FontSize="24"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock x:Name="UserInfoTextBlock"
                          FontSize="14"
                          Foreground="#ECF0F1"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Theme Settings -->
                <Border Background="#3498DB" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Theme Settings"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,15"/>

                        <TextBlock Text="Select Theme:" Foreground="White" Margin="0,5,0,5"/>
                        <ComboBox x:Name="ThemeComboBox"
                                 SelectionChanged="ThemeComboBox_SelectionChanged"
                                 Padding="8"
                                 FontSize="14">
                            <ComboBoxItem Content="Default (Light)" Tag="Default"/>
                            <ComboBoxItem Content="Dark Green (Fluoro)" Tag="DarkGreen"/>
                            <ComboBoxItem Content="Custom" Tag="Custom"/>
                        </ComboBox>

                        <!-- Custom Theme Options -->
                        <StackPanel x:Name="CustomThemePanel" Visibility="Collapsed" Margin="0,15,0,0">
                            <TextBlock Text="Custom Background Color:" Foreground="White" Margin="0,5,0,5"/>
                            <TextBox x:Name="CustomBackgroundTextBox" Text="#000000" Padding="8"/>

                            <TextBlock Text="Custom Text Color:" Foreground="White" Margin="0,10,0,5"/>
                            <TextBox x:Name="CustomTextTextBox" Text="#00FF00" Padding="8"/>

                            <TextBlock Text="Custom Accent Color:" Foreground="White" Margin="0,10,0,5"/>
                            <TextBox x:Name="CustomAccentTextBox" Text="#00FF00" Padding="8"/>

                            <Button Content="Preview Custom Theme"
                                   Click="PreviewTheme_Click"
                                   Margin="0,10,0,0"
                                   Padding="10,5"
                                   Background="#27AE60"
                                   Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Login Settings -->
                <Border Background="#27AE60" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Login Settings"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,15"/>

                        <CheckBox x:Name="RememberMeCheckBox"
                                 Content="Remember Me (Save username)"
                                 Foreground="White"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <CheckBox x:Name="AutoLoginCheckBox"
                                 Content="Auto Login (Skip login screen)"
                                 Foreground="White"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <TextBlock Text="⚠️ Auto Login will log you in automatically on app startup"
                                  Foreground="#FFE4CC"
                                  FontSize="11"
                                  Margin="20,5,0,0"
                                  TextWrapping="Wrap"
                                  FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Window Settings -->
                <Border Background="#9B59B6" Padding="20" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Window Settings"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,15"/>

                        <CheckBox x:Name="StayOnTopCheckBox"
                                 Content="Always Stay On Top"
                                 Foreground="White"
                                 FontSize="14"
                                 Margin="0,5"
                                 Checked="StayOnTop_Changed"
                                 Unchecked="StayOnTop_Changed"/>

                        <TextBlock Text="Keep the application window above all other windows"
                                  Foreground="White"
                                  FontSize="11"
                                  Margin="20,5,0,0"
                                  TextWrapping="Wrap"
                                  FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Preview Panel -->
                <Border x:Name="PreviewPanel" Background="#34495E" Padding="20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Theme Preview"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,10"/>
                        <Border x:Name="PreviewBorder"
                               Background="Black"
                               Padding="15"
                               BorderThickness="2"
                               BorderBrush="Lime"
                               CornerRadius="5">
                            <StackPanel>
                                <TextBlock x:Name="PreviewText"
                                          Text="Sample Text"
                                          Foreground="Lime"
                                          FontSize="16"/>
                                <Button Content="Sample Button"
                                       Background="Lime"
                                       Foreground="Black"
                                       Margin="0,10,0,0"
                                       Padding="10,5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save Settings"
                   Click="Save_Click"
                   Padding="25,12"
                   Margin="5"
                   Background="#27AE60"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="Bold"/>
            <Button Content="Cancel"
                   Click="Cancel_Click"
                   Padding="25,12"
                   Margin="5"
                   Background="#95A5A6"
                   Foreground="White"
                   FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>
