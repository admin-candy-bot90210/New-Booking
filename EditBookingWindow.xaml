<Window x:Class="DJBookingSystem.EditBookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit DJ Booking" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Edit DJ Booking" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <TextBlock Text="DJ Name:*" Margin="0,5,0,2"/>
                <TextBox x:Name="DJNameTextBox" Padding="5"/>

                <TextBlock Text="Streaming Link:*" Margin="0,10,0,2"/>
                <TextBox x:Name="StreamingLinkTextBox" Padding="5"/>

                <TextBlock Text="Venue:*" Margin="0,10,0,2"/>
                <ComboBox x:Name="VenueComboBox" Padding="5"/>

                <TextBlock Text="Booking Date:*" Margin="0,10,0,2"/>
                <DatePicker x:Name="BookingDatePicker" Padding="5" Margin="0,0,0,5"/>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Time:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="HourComboBox" Width="60"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0"/>
                    <ComboBox x:Name="MinuteComboBox" Width="60"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save"
                   Click="Save_Click"
                   Padding="20,10"
                   Margin="5"
                   Background="#27AE60"
                   Foreground="White"/>
            <Button Content="Cancel"
                   Click="Cancel_Click"
                   Padding="20,10"
                   Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
