<Window x:Class="DJBookingSystem.VenueRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Your Room/Venue" Height="700" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Register Your Room/Venue for Free DJ Services"
                          FontSize="20"
                          FontWeight="Bold"
                          Margin="0,0,0,10"
                          TextWrapping="Wrap"/>

                <TextBlock Text="All DJ services are provided free of charge! DJ slots are 1 hour long."
                          FontSize="12"
                          FontStyle="Italic"
                          Foreground="#27AE60"
                          Margin="0,0,0,20"
                          TextWrapping="Wrap"/>

                <!-- Room/Venue Information -->
                <Border Background="#ECF0F1" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Room/Venue Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                        <TextBlock Text="Room Name:*" Margin="0,5,0,2"/>
                        <TextBox x:Name="RoomNameTextBox" Padding="5"/>
                        <TextBlock Text="Example: The Blue Room, Main Hall, Studio A"
                                  FontSize="11"
                                  FontStyle="Italic"
                                  Foreground="Gray"
                                  Margin="0,2,0,0"/>

                        <TextBlock Text="Room Description:*" Margin="0,15,0,2"/>
                        <TextBox x:Name="RoomDescriptionTextBox"
                                Padding="5"
                                Height="80"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Describe your room/venue (capacity, equipment, atmosphere, etc.)"
                                  FontSize="11"
                                  FontStyle="Italic"
                                  Foreground="Gray"
                                  Margin="0,2,0,0"/>

                        <TextBlock Text="Discord Webhook URL: (Optional)" Margin="0,15,0,2"/>
                        <TextBox x:Name="DiscordWebhookTextBox" Padding="5"/>
                        <TextBlock Text="Enter a Discord webhook URL to receive booking notifications in your channel"
                                  FontSize="11"
                                  FontStyle="Italic"
                                  Foreground="Gray"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Opening Days Schedule -->
                <Border Background="#3498DB" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Opening Days Schedule"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Select which days your venue is open for DJ bookings:"
                                  FontSize="12"
                                  Foreground="White"
                                  Margin="0,0,0,10"
                                  TextWrapping="Wrap"/>

                        <!-- Monday -->
                        <CheckBox x:Name="MondayCheckBox"
                                 Content="Monday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <!-- Tuesday -->
                        <CheckBox x:Name="TuesdayCheckBox"
                                 Content="Tuesday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <!-- Wednesday -->
                        <CheckBox x:Name="WednesdayCheckBox"
                                 Content="Wednesday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <!-- Thursday -->
                        <CheckBox x:Name="ThursdayCheckBox"
                                 Content="Thursday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <!-- Friday -->
                        <CheckBox x:Name="FridayCheckBox"
                                 Content="Friday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <!-- Saturday -->
                        <CheckBox x:Name="SaturdayCheckBox"
                                 Content="Saturday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <!-- Sunday -->
                        <CheckBox x:Name="SundayCheckBox"
                                 Content="Sunday"
                                 Foreground="White"
                                 FontWeight="Bold"
                                 FontSize="14"
                                 Margin="0,5"/>

                        <TextBlock Text="Note: Only days you check will be available for DJ bookings"
                                  FontSize="11"
                                  FontStyle="Italic"
                                  Foreground="#FFE4CC"
                                  Margin="0,10,0,0"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="AcceptTermsCheckBox"
                         Margin="0,10,0,0">
                    <TextBlock Text="I confirm that all information is accurate and I agree to host DJs at this venue free of charge. Each DJ slot is 1 hour long."
                              TextWrapping="Wrap"/>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Register Room/Venue"
                   Click="RegisterVenue_Click"
                   Padding="20,10"
                   Margin="5"
                   Background="#27AE60"
                   Foreground="White"
                   FontSize="14"
                   FontWeight="Bold"/>
            <Button Content="Cancel"
                   Click="Cancel_Click"
                   Padding="20,10"
                   Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
