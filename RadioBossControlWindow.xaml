<Window x:Class="DJBookingSystem.RadioBossControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadioBOSS API Control Panel" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="RadioBOSS Cloud API Control"
                          FontSize="22"
                          FontWeight="Bold"
                          Foreground="White"/>
                <TextBlock Text="Station ID: 98 | API Key: 8VTO5355BZ5X"
                          FontSize="12"
                          Foreground="#ECF0F1"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Station Status Section -->
                <Border Background="#ECF0F1" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Station Status"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Status:" FontWeight="Bold" Margin="0,5,0,2"/>
                                <TextBlock x:Name="StatusTextBlock" Text="Unknown" FontSize="14"/>

                                <TextBlock Text="Listeners:" FontWeight="Bold" Margin="0,10,0,2"/>
                                <TextBlock x:Name="ListenersTextBlock" Text="0" FontSize="14"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Button Content="Refresh Status"
                                       Click="RefreshStatus_Click"
                                       Padding="10,5"
                                       Background="#3498DB"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Now Playing Section -->
                <Border Background="#ECF0F1" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Now Playing"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <TextBlock x:Name="NowPlayingTextBlock"
                                  Text="No track information"
                                  TextWrapping="Wrap"
                                  FontSize="14"
                                  Margin="0,0,0,10"/>

                        <Button Content="Refresh Track Info"
                               Click="RefreshTrack_Click"
                               Padding="10,5"
                               Background="#27AE60"
                               Foreground="White"
                               BorderThickness="0"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Playlist Section -->
                <Border Background="#ECF0F1" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Playlist"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PlaylistTextBlock"
                                      Text="Click 'Load Playlist' to view"
                                      TextWrapping="Wrap"
                                      FontSize="12"
                                      Margin="0,0,0,10"/>
                        </ScrollViewer>

                        <Button Content="Load Playlist"
                               Click="LoadPlaylist_Click"
                               Padding="10,5"
                               Background="#9B59B6"
                               Foreground="White"
                               BorderThickness="0"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Upcoming Events Section -->
                <Border Background="#ECF0F1" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Upcoming Scheduled Events"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="EventsTextBlock"
                                      Text="Click 'Load Events' to view"
                                      TextWrapping="Wrap"
                                      FontSize="12"
                                      Margin="0,0,0,10"/>
                        </ScrollViewer>

                        <Button Content="Load Upcoming Events"
                               Click="LoadEvents_Click"
                               Padding="10,5"
                               Background="#E67E22"
                               Foreground="White"
                               BorderThickness="0"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Artwork Control Section -->
                <Border Background="#ECF0F1" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Set Stream Artwork"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Artwork URL:" Margin="0,5,0,2"/>
                        <TextBox x:Name="ArtworkUrlTextBox"
                                Padding="5"
                                Margin="0,0,0,10"/>

                        <Button Content="Set Artwork"
                               Click="SetArtwork_Click"
                               Padding="10,5"
                               Background="#E74C3C"
                               Foreground="White"
                               BorderThickness="0"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Full Web Interface Button -->
                <Border Background="#34495E" Padding="15">
                    <StackPanel>
                        <TextBlock Text="Need More Control?"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,10"/>

                        <Button Content="Open Full RadioBOSS Web Interface"
                               Click="OpenWebInterface_Click"
                               Padding="15,10"
                               Background="#1ABC9C"
                               Foreground="White"
                               BorderThickness="0"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"/>

                        <TextBlock Text="Opens embedded browser with auto-login"
                                  FontSize="11"
                                  Foreground="#BDC3C7"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
