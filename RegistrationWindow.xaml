<Window x:Class="DJBookingSystem.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register New Account" Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="20" Margin="-30,-30,-30,20">
            <StackPanel>
                <TextBlock Text="Create Your Account"
                          FontSize="26"
                          FontWeight="Bold"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Join the DJ Booking Community!"
                          FontSize="14"
                          Foreground="#ECF0F1"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Account Type Selection -->
                <Border Background="#E67E22" Padding="15" Margin="0,0,0,20" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="I am registering as:"
                                  FontSize="16"
                                  FontWeight="Bold"
                                  Foreground="White"
                                  Margin="0,0,0,10"/>
                        <CheckBox x:Name="IsDJCheckBox"
                                 Content="DJ (I want to book gigs)"
                                 Foreground="White"
                                 FontSize="14"
                                 Margin="0,5"/>
                        <CheckBox x:Name="IsVenueOwnerCheckBox"
                                 Content="Venue Owner (I want to offer my venue)"
                                 Foreground="White"
                                 FontSize="14"
                                 Margin="0,5"/>
                        <TextBlock Text="You can select both if applicable!"
                                  FontSize="11"
                                  Foreground="#FFE4CC"
                                  Margin="0,10,0,0"
                                  FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Personal Information -->
                <TextBlock Text="Full Name*" Margin="0,5,0,2" FontWeight="Bold"/>
                <TextBox x:Name="FullNameTextBox" Padding="8" FontSize="14"/>

                <TextBlock Text="Username*" Margin="0,10,0,2" FontWeight="Bold"/>
                <TextBox x:Name="UsernameTextBox" Padding="8" FontSize="14"/>

                <TextBlock Text="Email Address*" Margin="0,10,0,2" FontWeight="Bold"/>
                <TextBox x:Name="EmailTextBox" Padding="8" FontSize="14"/>

                <TextBlock Text="Password*" Margin="0,10,0,2" FontWeight="Bold"/>
                <PasswordBox x:Name="PasswordBox" Padding="8" FontSize="14"/>

                <TextBlock Text="Confirm Password*" Margin="0,10,0,2" FontWeight="Bold"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Padding="8" FontSize="14"/>

                <!-- Terms Agreement -->
                <CheckBox x:Name="AgreeTermsCheckBox" Margin="0,20,0,0">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="I agree to the "/>
                        <Run Text="Terms of Service" FontWeight="Bold" Foreground="#3498DB"/>
                        <Run Text=" and "/>
                        <Run Text="Privacy Policy" FontWeight="Bold" Foreground="#3498DB"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Register"
                   Click="Register_Click"
                   Padding="30,12"
                   Margin="5"
                   Background="#27AE60"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="Bold"
                   BorderThickness="0"/>
            <Button Content="Back to Login"
                   Click="BackToLogin_Click"
                   Padding="30,12"
                   Margin="5"
                   Background="#95A5A6"
                   Foreground="White"
                   FontSize="16"
                   BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
